<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:f="/lib/form">
  <st:adjunct includes="io.jenkins.plugins.gitlabregistry.lazy-tags"/>

  <j:set var="fetchUrl" value="${rootURL}/${it.descriptor.currentDescriptorByNameUrl}/${it.descriptor.descriptorUrl}/fetchTags"/>
  <j:set var="defaultVal" value="${it.resolvedDefault}"/>

  <j:set var="escapeEntryTitleAndDescription" value="false"/>
  <f:entry title="${h.escape(it.name)}" description="${it.formattedDescription}">
    <div class="jenkins-select" name="parameter">
      <input type="hidden" name="name" value="${it.name}" />
      <select class="jenkins-select__input"
              name="value"
              aria-label="${it.name}"
              data-gri-lazy="true"
              data-fetch-url="${fetchUrl}"
              data-descriptor-id="${it.descriptor.id}"
              data-param-name="${it.name}"
              data-default-version="${defaultVal}">
        <j:choose>
          <j:when test="${defaultVal != ''}">
            <option value="${defaultVal}" selected="true">${defaultVal}</option>
          </j:when>
          <j:otherwise>
            <option value="" selected="true">— click to load tags —</option>
          </j:otherwise>
        </j:choose>
      </select>
    </div>
  </f:entry>
</j:jelly>
