<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <st:adjunct includes="io.jenkins.plugins.gitlabregistry.clear-test-status"/>
  <f:entry title="Name" field="name">
    <f:textbox/>
  </f:entry>
  <f:entry title="Description" field="description">
    <f:textarea/>
  </f:entry>

  <f:entry title="GitLab Repo URL" field="repoUrl">
    <f:textbox/>
  </f:entry>
  <f:entry title="Credentials" field="credentialsId">
    <c:select/>
  </f:entry>
  <f:validateButton
     title="${%Test connection}" progress="${%Testing…}"
     method="testConnection" with="repoUrl,credentialsId"/>

  <f:entry title="Image name" field="imageName">
    <f:textbox/>
  </f:entry>
  <f:entry title="Default version" field="defaultVersion">
    <f:textbox/>
  </f:entry>

  <f:advanced title="Advanced">
    <f:entry title="Exclude" field="exclude">
      <f:textbox/>
    </f:entry>
    <f:entry title="Regex" field="regex">
      <f:textbox/>
    </f:entry>
    <f:entry title="Values per page" field="perPage">
      <f:number default="50"/>
    </f:entry>
    <f:entry title="Max Pages" field="maxPages">
      <f:number default="2"/>
    </f:entry>
    <f:entry title="Max values in list" field="maxRows">
      <f:number default="30"/>
    </f:entry>
    <f:entry title="Sort mode" field="sortMode">
      <f:select default="NONE"/>
    </f:entry>
    <f:entry title="Connect timeout (ms)" field="connectTimeoutMs">
      <f:number default="5000"/>
    </f:entry>
    <f:entry title="Read timeout (ms)" field="readTimeoutMs">
      <f:number default="5000"/>
    </f:entry>
  </f:advanced>
</j:jelly>
